# Public Supabase configuration (safe to expose in the browser bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only secret. Never prefix this variable with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_Q5-SyFihEagmVtYI2Qt--A_-5u22xYT

# Optional public application URL used when generating branch QR links.
VITE_PUBLIC_APP_URL=https://your-production-domain.example
